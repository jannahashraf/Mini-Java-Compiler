/* Program 1: types, literals and declarations. */
class Values {
    public static void main() {
        int age = 20;
        float grade = 85.5;
        boolean passed = true;
        boolean absent = false;
        char letter = 'A';
        String name = "Ali";
        String markers = "http://host/*path*/";
        int _count = 0;
        return;
    }
}

// Program 2: loops, comparisons and arithmetic.
class ControlFlow {
    public static void main() {
        int i = 0, total = 0;
        for (i = 0; i < 3; i = i + 1) {
            total = total + i;
        }
        while (total <= 10) {
            total = total + 1;
        }
        if (total >= 10) {
            total = total - 1;
        } else {
            total = 0;
        }
        if (total == 9) { total = total * 2; }
        if (total != 0) { total = total / 2; }
        if (total > 3) { total = total % 3; }
        return;
    }
}

/* Program 3: case sensitivity, arrays, member access and comment boundaries. */
class Names {
    public static int value;
    public static void main(String[] args) {
        int Class = 1;
        int className = 2;
        int string = 3;
        int True = 4;
        int _count = Class/* gap */+className;
        String first = args[0];
        Names.value = _count;
        return;
    }
}
